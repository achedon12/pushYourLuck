{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test:unit*)",
      "Bash(npm run test:functional*)",
      "Bash(npm run test:visual*)",
      "Bash(npm run sim)",
      "Bash(npm run smoke)",
      "Bash(npm run logos)",
      "Bash(npm run backup)",
      "Bash(npm run db:up)",
      "Bash(npm run db:down)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:studio)",
      "Bash(npm run db:test:setup)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest run*)",
      "Bash(npx playwright test*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx prisma migrate diff*)",
      "Bash(npx prisma migrate resolve*)",
      "Bash(npx prisma format*)",
      "Bash(node --version)",
      "Bash(node -e *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(docker compose -f docker-compose.dev.yml up*)",
      "Bash(docker compose -f docker-compose.dev.yml down)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash*)"
    ],
    "deny": [
      "Bash(npx prisma db push*)",
      "Bash(npm run db:push*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(rm -rf prisma/migrations*)",
      "Bash(rm -rf dump*)",
      "Bash(rm -rf mysql-data*)",
      "Bash(docker compose down -v*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)"
    ]
  }
}
