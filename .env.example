# Copier en `.env` et renseigner. Ce fichier-ci est versionné, le `.env` non.

# --- Base de données ---
# En développement, la base tourne via docker-compose.dev.yml sur le port 3307.
DATABASE_URL="mysql://pushyourluck:pushyourluck@127.0.0.1:3307/pushyourluck"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://pushyourluck.net"

# --- Mesure d'audience (Matomo auto-hébergé, sans cookie) ---
# Vides = aucune mesure, le site fonctionne à l'identique.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# --- PRODUCTION uniquement (docker-compose.yml) ---
# Sans ces deux variables, la stack refuse de démarrer : c'est voulu, le dépôt
# est public et aucun mot de passe ne doit y figurer en valeur de repli.
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# Port hôte du conteneur applicatif. À changer si le loup-garou occupe déjà
# 3001 sur la même machine.
# PYL_HOST_PORT=3001
